# Riot Games API key — obtain from https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Platform ID for league & summoner endpoints (na1, euw1, kr, etc.)
RIOT_PLATFORM=na1

# Regional routing for match endpoints (americas, europe, asia, sea)
RIOT_REGION=americas
